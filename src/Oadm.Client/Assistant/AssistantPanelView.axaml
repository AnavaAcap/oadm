<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:a="using:Oadm.Client.Assistant"
             xmlns:tc="using:Oadm.Theme.Controls"
             x:Class="Oadm.Client.Assistant.AssistantPanelView"
             x:DataType="a:AssistantPanelViewModel">
  <!-- The Assistant panel (docs/spec/assistant.md "The panel"): title with New chat and Close, the conversation (a virtualized
       list, one template per kind of entry), the start suggestions while it is empty, Go to the latest while scrolled up,
       and at the bottom the message box like the chat apps (Border.composer: the attached files, the text, Attach file, the
       model and the send arrow / Stop), its problem and the selection count below it. Files dropped on the panel attach. -->
  <Panel>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" Margin="0,0,0,12">
      <TextBlock Classes="cardTitle" Text="{x:Static a:AssistantTexts.Title}" VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="CopyChat" Classes="toolbar iconOnly" VerticalAlignment="Center" Command="{Binding CopyChatCommand}"
              ToolTip.Tip="{x:Static a:AssistantTexts.CopyChat}">
        <ui:OadmIcon Data="{StaticResource Icon.copy}" />
      </Button>
      <ui:ToolbarButton Grid.Column="2" x:Name="NewChat" Text="{x:Static a:AssistantTexts.NewChat}" IconKey="edit" Command="{Binding NewChatCommand}"
                        VerticalAlignment="Center" />
      <Button Grid.Column="3" x:Name="ClosePanel" Classes="toolbar iconOnly" VerticalAlignment="Center" Command="{Binding CloseCommand}"
              ToolTip.Tip="{x:Static a:AssistantTexts.Close}">
        <ui:OadmIcon Data="{StaticResource Icon.close}" />
      </Button>
    </Grid>

    <!-- Bottom: the message box with the attached files, the text and its row of buttons; below it its problem, a message
         (Copied., an upload's problem) and the selection that goes along. -->
    <StackPanel DockPanel.Dock="Bottom">
      <Border x:Name="Composer" Classes="composer" Classes.error="{Binding HasComposerError}">
        <StackPanel Spacing="8">
          <!-- The devices chosen with @ or Choose devices: one chip, a click opens the picker with that choice. -->
          <Border x:Name="MentionChip" Classes="chatChip" HorizontalAlignment="Left" IsVisible="{Binding HasMention}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="link" Command="{Binding ChooseDevicesCommand}" ToolTip.Tip="{x:Static a:AssistantTexts.ChooseDevices}">
                <ui:IconLabel Icon="{StaticResource Icon.devices}" Text="{Binding MentionText}" />
              </Button>
              <Button Classes="toolbar iconOnly" Command="{Binding RemoveMentionCommand}" ToolTip.Tip="{x:Static a:AssistantTexts.RemoveDevices}">
                <ui:OadmIcon Data="{StaticResource Icon.close}" />
              </Button>
            </StackPanel>
          </Border>
          <ItemsControl x:Name="AttachmentList" ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="a:AssistantAttachmentItem">
                <Border Classes="chatChip">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:OadmIcon Data="{StaticResource Icon.file}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="secondary" Text="{Binding SizeText}" VerticalAlignment="Center" />
                    <Button Classes="toolbar iconOnly" ToolTip.Tip="{x:Static a:AssistantTexts.RemoveFile}"
                            Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).RemoveAttachmentCommand}" CommandParameter="{Binding}">
                      <ui:OadmIcon Data="{StaticResource Icon.close}" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ui:ProgressRow Text="{x:Static a:AssistantTexts.Uploading}" IsVisible="{Binding IsUploading}" />
          <TextBox x:Name="MessageBox" Classes="composer" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap"
                   MaxLength="{x:Static a:AssistantTexts.MaxMessageLength}" PlaceholderText="{x:Static a:AssistantTexts.Placeholder}" />
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="4">
            <Button x:Name="AttachFile" Classes="toolbar iconOnly" Command="{Binding AttachFileCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding AttachButtonTip}" ToolTip.ShowOnDisabled="True">
              <ui:OadmIcon Data="{StaticResource Icon.paperclip}" />
            </Button>
            <Button Grid.Column="1" x:Name="ChooseDevices" Classes="toolbar iconOnly" Command="{Binding ChooseDevicesCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="{x:Static a:AssistantTexts.ChooseDevices}">
              <ui:OadmIcon Data="{StaticResource Icon.devices}" />
            </Button>
            <Panel Grid.Column="2" VerticalAlignment="Center">
              <ComboBox x:Name="ModelPicker" Classes="composerModel" MaxWidth="200" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" Text="{Binding Model}"
                        IsEditable="{Binding IsModelEditable}" IsVisible="{Binding !IsLoadingModels}" PlaceholderText="{x:Static a:AssistantTexts.ModelTip}"
                        ToolTip.Tip="{x:Static a:AssistantTexts.ModelTip}" />
              <StackPanel Orientation="Horizontal" Spacing="6" Height="{StaticResource Oadm.ControlHeight}" IsVisible="{Binding IsLoadingModels}">
                <ui:ProgressRing Classes="thinking" />
                <TextBlock Classes="secondary" Text="{x:Static a:AssistantTexts.LoadingModels}" VerticalAlignment="Center" />
              </StackPanel>
            </Panel>
            <Panel Grid.Column="4" VerticalAlignment="Center">
              <Button x:Name="Send" Classes="send" Classes.quiet="{Binding SendIsQuiet}" Command="{Binding SendCommand}" IsVisible="{Binding !IsStreaming}"
                      ToolTip.Tip="{Binding SendButtonTip}" ToolTip.ShowOnDisabled="True">
                <ui:OadmIcon Data="{StaticResource Icon.arrowUp}" />
              </Button>
              <Button x:Name="Stop" Classes="send" Classes.quiet="{Binding SendIsQuiet}" Command="{Binding StopCommand}" IsVisible="{Binding IsStreaming}"
                      ToolTip.Tip="{x:Static a:AssistantTexts.Stop}">
                <ui:OadmIcon Data="{StaticResource Icon.square}" />
              </Button>
            </Panel>
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock x:Name="ComposerError" Classes="fieldMessage error" Text="{Binding ComposerError}" IsVisible="{Binding HasComposerError}" />
      <TextBlock Text="{Binding Message}" Classes="fieldMessage" Classes.error="{Binding MessageIsError}"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock x:Name="SelectionCount" Classes="fieldMessage" Text="{Binding SelectionText}" IsVisible="{Binding HasSelection}" />
    </StackPanel>

    <Panel>
      <!-- Empty: the mark, the question, the live counts of the devices (a click asks about them) and at most four suggestions
           for the moment (the selection, the page, the role); a click sends one. -->
      <ScrollViewer IsVisible="{Binding IsEmpty}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Suggestions" Classes="chatStart">
          <tc:OadmMark Width="48" Height="48" HorizontalAlignment="Center" />
          <TextBlock Classes="sectionTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{x:Static a:AssistantTexts.StartHeading}" />
          <ItemsControl x:Name="StartChips" ItemsSource="{Binding StartChips}" IsVisible="{Binding HasStartChips}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="a:AssistantStartChip">
                <Button Classes="startChip" Content="{Binding Text}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).SendSuggestionCommand}" CommandParameter="{Binding Question}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="StartCards" ItemsSource="{Binding StartCards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" ColumnSpacing="8" RowSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="a:AssistantStartCard">
                <Button Classes="startCard" Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).SendSuggestionCommand}" CommandParameter="{Binding Text}">
                  <StackPanel Spacing="8">
                    <ui:OadmIcon Data="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ListBox x:Name="Conversation" Classes="readOnlyList chatList" ItemsSource="{Binding Items}" IsVisible="{Binding !IsEmpty}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.DataTemplates>
          <DataTemplate x:DataType="a:AssistantUserItem">
            <Panel Classes="chatUserRow">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button x:Name="EditMessage" Classes="toolbar iconOnly hoverAction" VerticalAlignment="Top" IsVisible="{Binding CanEdit}"
                        ToolTip.Tip="{x:Static a:AssistantTexts.Edit}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).EditCommand}" CommandParameter="{Binding}">
                  <ui:OadmIcon Data="{StaticResource Icon.edit}" />
                </Button>
                <Border Classes="chatUser">
                  <StackPanel Spacing="4">
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <ui:IconLabel Icon="{StaticResource Icon.paperclip}" Text="{Binding FilesText}" IsVisible="{Binding HasFiles}" />
                    <ui:IconLabel Icon="{StaticResource Icon.devices}" Text="{Binding MentionText}" IsVisible="{Binding HasMention}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Panel>
          </DataTemplate>
          <DataTemplate x:DataType="a:AssistantThinkingItem">
            <StackPanel x:Name="Thinking" Orientation="Horizontal" Spacing="8">
              <ui:ProgressRing Classes="thinking" />
              <TextBlock Classes="secondary" Text="{x:Static a:AssistantTexts.Thinking}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate x:DataType="a:AssistantAnswerItem">
            <StackPanel Classes="chatItem">
              <c:MarkdownText Markdown="{Binding Text}" Actions="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext)}" />
              <StackPanel Classes="chatActions">
                <Button Classes="toolbar iconOnly" ToolTip.Tip="{x:Static a:AssistantTexts.Copy}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).CopyCommand}" CommandParameter="{Binding}">
                  <ui:OadmIcon Data="{StaticResource Icon.copy}" />
                </Button>
                <Button x:Name="RetryAnswer" Classes="toolbar iconOnly" ToolTip.Tip="{x:Static a:AssistantTexts.TryAgain}" IsVisible="{Binding ShowsRetry}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).RetryCommand}" CommandParameter="{Binding}">
                  <ui:OadmIcon Data="{StaticResource Icon.rotateCcw}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
          <DataTemplate x:DataType="a:AssistantToolItem">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:OadmIcon Data="{StaticResource Icon.wrench}" />
              <TextBlock Text="{Binding Text}" Classes.secondary="{Binding !Failed}" Classes.error="{Binding Failed}" VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate x:DataType="a:AssistantNoticeItem">
            <StackPanel Classes="chatItem">
              <TextBlock Text="{Binding Text}" Classes.secondary="{Binding !IsError}" Classes.error="{Binding IsError}" TextWrapping="Wrap" />
              <StackPanel Classes="chatActions" IsVisible="{Binding ShowsRetry}">
                <Button x:Name="RetryNotice" Classes="toolbar iconOnly" ToolTip.Tip="{x:Static a:AssistantTexts.TryAgain}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).RetryCommand}" CommandParameter="{Binding}">
                  <ui:OadmIcon Data="{StaticResource Icon.rotateCcw}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
          <DataTemplate x:DataType="a:AssistantPictureItem">
            <StackPanel Spacing="4">
              <Button Classes="picture" HorizontalAlignment="Left" ToolTip.Tip="{x:Static a:AssistantTexts.Enlarge}"
                      Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).EnlargeCommand}" CommandParameter="{Binding}">
                <Border Classes="chatPicture">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                </Border>
              </Button>
              <TextBlock Classes="secondary small" Text="{Binding DeviceName}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate x:DataType="a:AssistantTableItem">
            <StackPanel Classes="chatItem">
              <DataGrid ItemsSource="{Binding ShownRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" IsReadOnly="True" SelectionMode="Single"
                        CanUserReorderColumns="False" CanUserSortColumns="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{x:Static a:AssistantTexts.ColumnName}" Width="*" Binding="{Binding Name}" x:DataType="a:AssistantTableRow" />
                  <DataGridTextColumn Header="{x:Static a:AssistantTexts.ColumnAddress}" Width="110" Binding="{Binding Address}" x:DataType="a:AssistantTableRow" />
                  <DataGridTextColumn Header="{x:Static a:AssistantTexts.ColumnModel}" Width="100" Binding="{Binding Model}" x:DataType="a:AssistantTableRow" />
                  <DataGridTextColumn Width="100" Binding="{Binding Fourth}" x:DataType="a:AssistantTableRow">
                    <DataGridTextColumn.Header>
                      <TextBlock Text="{Binding $parent[DataGrid].((a:AssistantTableItem)DataContext).FourthHeader}" />
                    </DataGridTextColumn.Header>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMore}">
                <TextBlock Classes="secondary" Text="{Binding MoreText}" VerticalAlignment="Center" />
                <Button Classes="link" Content="{x:Static a:AssistantTexts.SelectAllInGrid}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).SelectAllCommand}" CommandParameter="{Binding}" />
              </StackPanel>
              <StackPanel Classes="chatActions" IsVisible="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).CanExportTables}">
                <Button x:Name="CopyTableCsv" Classes="toolbar iconOnly" ToolTip.Tip="{x:Static a:AssistantTexts.CopyCsv}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).CopyTableCsvCommand}" CommandParameter="{Binding}">
                  <ui:OadmIcon Data="{StaticResource Icon.copy}" />
                </Button>
                <Button x:Name="SaveTableCsv" Classes="toolbar iconOnly" ToolTip.Tip="{x:Static a:AssistantTexts.SaveCsv}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).SaveTableCsvCommand}" CommandParameter="{Binding}">
                  <ui:OadmIcon Data="{StaticResource Icon.download}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
          <DataTemplate x:DataType="a:AssistantPreviewItem">
            <Border Classes="chatCard">
              <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Classes="sectionTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                  <TextBlock Classes="secondary" Text="{Binding CountText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Details}" IsVisible="{Binding HasDetails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DevicesText}" TextWrapping="Wrap" IsVisible="{Binding HasDevices}" />
                <ItemsControl ItemsSource="{Binding Skipped}" IsVisible="{Binding HasSkipped}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="secondary" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:OadmIcon Data="{StaticResource Icon.triangleAlert}" />
                        <TextBlock Classes="warning" Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsReady}">
                  <Button Classes="secondary" Content="{x:Static a:AssistantTexts.Cancel}"
                          Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).CancelPreviewCommand}" CommandParameter="{Binding}" />
                  <Button x:Name="RunPreview" Classes.primary="{Binding RunIsPrimary}" Classes.secondary="{Binding RunIsSecondary}"
                          Classes.danger="{Binding IsDestructive}" Content="{x:Static a:AssistantTexts.Run}"
                          Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).RunPreviewCommand}" CommandParameter="{Binding}" />
                </StackPanel>
                <DockPanel IsVisible="{Binding HasStatus}">
                  <Button DockPanel.Dock="Right" Classes="link" Content="{x:Static a:AssistantTexts.ShowTasks}" IsVisible="{Binding IsStarted}"
                          Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).ShowTasksCommand}" />
                  <ui:StatusChip HorizontalAlignment="Left" Text="{Binding StatusText}" IsAccent="{Binding IsActive}" IsOk="{Binding IsDone}"
                                 IsError="{Binding HasFailed}" MaxLines="2" />
                </DockPanel>
                <Button x:Name="RetryFailed" Classes="link" HorizontalAlignment="Left" Content="{x:Static a:AssistantTexts.RetryFailed}" IsVisible="{Binding CanRetryFailed}"
                        Command="{Binding $parent[a:AssistantPanelView].((a:AssistantPanelViewModel)DataContext).RetryFailedCommand}" CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>

      <!-- Scrolled up: the list stays where the user is; this goes to the end and follows again. -->
      <Button x:Name="JumpToLatest" Classes="jumpToLatest" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
              IsVisible="{Binding ShowJumpToLatest}" Command="{Binding JumpToLatestCommand}" ToolTip.Tip="{x:Static a:AssistantTexts.GoToLatest}">
        <ui:OadmIcon Data="{StaticResource Icon.arrowDown}" />
      </Button>
    </Panel>
  </DockPanel>

  <!-- Files dragged over the panel. -->
  <Border x:Name="DropHint" Classes="dropHint" IsVisible="{Binding IsDragOver}">
    <ui:IconLabel HorizontalAlignment="Center" VerticalAlignment="Center" Icon="{StaticResource Icon.paperclip}" Text="{x:Static a:AssistantTexts.DropFiles}" />
  </Border>
  </Panel>
</UserControl>
