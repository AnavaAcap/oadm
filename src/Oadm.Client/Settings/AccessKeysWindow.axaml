<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Oadm.Sdk.Client.Controls"
        xmlns:settings="using:Oadm.Client.Settings"
        x:Class="Oadm.Client.Settings.AccessKeysWindow"
        x:DataType="settings:AccessKeysViewModel"
        Title="Access keys"
        Width="860" Height="520" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly">
  <!-- Access keys of MCP (administrators, docs/spec/mcp.md "Access keys"), opened by the button Access keys of the card MCP:
       one card (like Waiting devices): the toolbar, the list; Create access key opens the form that shows the key once; Delete asks first and ends the key at once. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <ui:DialogTitleBar Grid.Row="0" Text="{x:Static settings:AccessKeyWords.Title}" />

    <Border Grid.Row="1" Classes="card" Margin="16,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ui:ToolbarOverflowPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
          <ui:ToolbarButton x:Name="CreateAccessKey" Text="{x:Static settings:AccessKeyWords.Create}" IconKey="add" Command="{Binding CreateCommand}" />
        </ui:ToolbarOverflowPanel>
        <ui:ProgressRow Grid.Row="1" Text="Reading the access keys" IsVisible="{Binding IsLoading}" />
        <TextBlock Grid.Row="2" Classes="secondary" Text="{x:Static settings:AccessKeyWords.Empty}" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
        <DataGrid Grid.Row="3" x:Name="KeysGrid" ItemsSource="{Binding Keys}" IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False"
                  SelectionMode="Single" IsVisible="{Binding HasKeys}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Width="*" MinWidth="110" Binding="{Binding Name}" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Role" Width="100" Binding="{Binding RoleName}" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Devices" Width="110" Binding="{Binding DevicesText}" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Created" Width="96" Binding="{Binding Created}" SortMemberPath="CreatedSortKey" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Expires" Width="96" Binding="{Binding Expires}" SortMemberPath="ExpiresSortKey" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Last used" Width="130" Binding="{Binding LastUsed}" SortMemberPath="LastUsedSortKey" CellStyleClasses="dimmed"
                                x:DataType="settings:AccessKeyRow" />
            <DataGridTemplateColumn Width="48" CanUserSort="False" x:DataType="settings:AccessKeyRow">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="settings:AccessKeyRow">
                  <Button Classes="toolbar iconOnly danger" ToolTip.Tip="Delete" Margin="6,0" HorizontalAlignment="Left"
                          Command="{Binding $parent[settings:AccessKeysWindow].((settings:AccessKeysViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                    <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Classes="error" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
    </Border>

    <ui:DialogFooter Grid.Row="2" CancelText="Close" CancelCommand="{Binding CloseCommand}" />
  </Grid>
</Window>
