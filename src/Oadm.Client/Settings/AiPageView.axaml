<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oadm.Sdk.Client.Controls"
             xmlns:c="using:Oadm.Client.Controls"
             xmlns:net="using:Oadm.Sdk.Network"
             xmlns:settings="using:Oadm.Client.Settings"
             xmlns:a="using:Oadm.Client.Assistant"
             x:Class="Oadm.Client.Settings.AiPageView"
             x:DataType="settings:AiAgentsViewModel">
  <!-- Rail page AI, every user (docs/spec/mcp.md, docs/spec/assistant.md "Settings"): the card MCP left, the card Assistant
       right (stacked on a narrow page, AiPageView.axaml.cs).
       Administrators turn the MCP server on and set the port and interface (Save); the certificate is the one the PKI policy
       MCP server picks. The status sits left of the buttons it reports on, like the EST server's. Access keys (administrators
       only), then Connect an agent: one compact row per client. -->
  <Grid RowDefinitions="Auto,*">
    <c:PageTitleBar Grid.Row="0" Title="AI" Subtitle="{x:Static settings:AiAgentsViewModel.PageSubtitle}" Margin="0,0,0,16" />
    <ScrollViewer Grid.Row="1">
    <Grid x:Name="Columns" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto" VerticalAlignment="Top">
    <Border Grid.Column="0" Classes="card" VerticalAlignment="Top">
    <StackPanel Classes="form">
      <TextBlock x:Name="McpSection" Classes="cardTitle" Text="MCP" />
      <TextBlock Classes="secondary" Text="{x:Static settings:AiAgentsViewModel.Intro}" TextWrapping="Wrap" />
      <StackPanel Classes="form" IsVisible="{Binding IsAdmin}">
        <ui:FormField Label="Port">
          <TextBox x:Name="McpPort" Text="{Binding Port}" Width="120" HorizontalAlignment="Left" />
        </ui:FormField>
        <ui:FormField Label="Listen on" InputWidth="320">
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Listen.Items}" SelectedItem="{Binding SelectedInterface}"
                    ToolTip.Tip="The interface agents reach this server on">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="net:InterfaceOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ui:FormField>
      </StackPanel>
      <StackPanel Classes="form" IsVisible="{Binding !IsAdmin}">
        <ui:FormField Label="Port">
          <TextBlock Text="{Binding Port}" />
        </ui:FormField>
        <ui:FormField Label="Listen on">
          <TextBlock Text="{Binding ListenText}" />
        </ui:FormField>
      </StackPanel>
      <ui:FormField Label="Certificate">
        <TextBlock Text="{Binding CertificateText}" TextWrapping="Wrap" />
      </ui:FormField>
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="McpSave" Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding IsAdmin}"
                ToolTip.Tip="{Binding SaveTip}" ToolTip.ShowOnDisabled="True" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" x:Name="McpTurnOn" Classes="secondary" Content="Turn on" Command="{Binding TurnOnCommand}" IsVisible="{Binding ShowTurnOn}"
                ToolTip.Tip="{Binding TurnOnTip}" ToolTip.ShowOnDisabled="True" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" x:Name="McpTurnOff" Classes="secondary" Content="Turn off" Command="{Binding TurnOffCommand}" IsVisible="{Binding ShowTurnOff}"
                Margin="8,0,0,0" />
        <ui:StatusChip HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding StatusText}" IsOk="{Binding Running}" IsError="{Binding HasProblem}" MaxLines="2" />
      </DockPanel>

      <!-- Access keys (administrators, docs/spec/mcp.md "Access keys"): Create access key opens the form that shows the key
           once; Delete asks first and ends the key at once. -->
      <StackPanel x:Name="AccessKeys" Classes="form" DataContext="{Binding Keys}" IsVisible="{Binding $parent[settings:AiPageView].((settings:AiAgentsViewModel)DataContext).IsAdmin}"
                  x:DataType="settings:AccessKeysViewModel">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="sectionTitle" Text="{x:Static settings:AccessKeyWords.Title}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ui:ToolbarButton x:Name="CreateAccessKey" Text="{x:Static settings:AccessKeyWords.Create}" IconKey="add" Command="{Binding CreateCommand}"
                            VerticalAlignment="Center" />
        </StackPanel>
        <ui:ProgressRow Text="Reading the access keys" IsVisible="{Binding IsLoading}" />
        <TextBlock Classes="secondary" Text="{x:Static settings:AccessKeyWords.Empty}" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
        <DataGrid x:Name="KeysGrid" ItemsSource="{Binding Keys}" IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False"
                  SelectionMode="Single" MaxHeight="300" IsVisible="{Binding HasKeys}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Width="*" MinWidth="110" Binding="{Binding Name}" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Role" Width="100" Binding="{Binding RoleName}" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Devices" Width="110" Binding="{Binding DevicesText}" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Created" Width="96" Binding="{Binding Created}" SortMemberPath="CreatedSortKey" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Expires" Width="96" Binding="{Binding Expires}" SortMemberPath="ExpiresSortKey" x:DataType="settings:AccessKeyRow" />
            <DataGridTextColumn Header="Last used" Width="130" Binding="{Binding LastUsed}" SortMemberPath="LastUsedSortKey" CellStyleClasses="dimmed"
                                x:DataType="settings:AccessKeyRow" />
            <DataGridTemplateColumn Width="48" CanUserSort="False" x:DataType="settings:AccessKeyRow">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="settings:AccessKeyRow">
                  <Button Classes="toolbar iconOnly danger" ToolTip.Tip="Delete" Margin="6,0" HorizontalAlignment="Left"
                          Command="{Binding $parent[settings:AiPageView].((settings:AiAgentsViewModel)DataContext).Keys.DeleteCommand}" CommandParameter="{Binding}">
                    <ui:OadmIcon Data="{StaticResource Icon.remove}" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Classes="error" Text="{Binding Message}" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- Connect an agent (docs/spec/mcp.md): one row per client with this server's address: Copy, and Download for a file. -->
      <StackPanel x:Name="ConnectAgent" Classes="form" IsVisible="{Binding HasConnections}">
        <TextBlock Classes="sectionTitle subsection" Text="Connect an agent" />
        <ItemsControl ItemsSource="{Binding Connections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="settings:AgentConnection">
              <ui:FormField Label="{Binding Title}" Classes="wide">
                <DockPanel>
                  <!-- Copy always rightmost, so the Copy buttons of all rows line up; Download left of it for a file. -->
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" VerticalAlignment="Center">
                    <Button Classes="toolbar iconOnly" ToolTip.Tip="{Binding DownloadTip}" IsVisible="{Binding IsFile}"
                            Command="{Binding $parent[settings:AiPageView].((settings:AiAgentsViewModel)DataContext).DownloadConnectionCommand}" CommandParameter="{Binding}">
                      <ui:OadmIcon Data="{StaticResource Icon.download}" />
                    </Button>
                    <Button Classes="toolbar iconOnly" ToolTip.Tip="{Binding CopyTip}"
                            Command="{Binding $parent[settings:AiPageView].((settings:AiAgentsViewModel)DataContext).CopyCommand}" CommandParameter="{Binding}">
                      <ui:OadmIcon Data="{StaticResource Icon.copy}" />
                    </Button>
                  </StackPanel>
                  <TextBlock Text="{Binding Line}" Classes.mono="{Binding ShowsText}" Classes.secondary="{Binding IsFile}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </ui:FormField>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="secondary" Text="{x:Static settings:AgentConnections.TrustCa}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary" Command="{Binding DownloadCaCommand}" IsEnabled="{Binding CanDownloadCa}">
          <ui:IconLabel Icon="{StaticResource Icon.download}" Text="Download CA certificate" />
        </Button>
        <Button x:Name="McpDownloadSkill" Classes="secondary" Command="{Binding DownloadSkillCommand}">
          <ui:IconLabel Icon="{StaticResource Icon.download}" Text="Download skill" />
        </Button>
      </StackPanel>
      <TextBlock Text="{Binding Message}" Classes.error="{Binding MessageIsError}" Classes.secondary="{Binding !MessageIsError}" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    </StackPanel>
    </Border>

      <!-- Card Assistant (docs/spec/assistant.md "Settings"): administrators edit, every other user reads it. The status sits
           left of the buttons it reports on, like the card MCP. -->
      <Border x:Name="AssistantCard" Grid.Column="2" Classes="card" VerticalAlignment="Top" IsVisible="{Binding Assistant.IsAvailable}">
      <StackPanel x:Name="AssistantSection" Classes="form" DataContext="{Binding Assistant}" x:DataType="a:AssistantSettingsViewModel">
        <TextBlock Classes="cardTitle" Text="{x:Static a:AssistantTexts.Title}" />
        <TextBlock Classes="secondary" Text="{x:Static a:AssistantTexts.SectionIntro}" TextWrapping="Wrap" />
        <StackPanel Classes="form" IsVisible="{Binding IsAdmin}">
          <ui:FormField Label="Provider" InputWidth="320" Hint="{Binding PrivacyNote}">
            <ComboBox x:Name="AssistantProvider" HorizontalAlignment="Stretch" ItemsSource="{x:Static a:AssistantProvider.All}" SelectedItem="{Binding Provider}" />
          </ui:FormField>
          <ui:FormField Label="Address" InputWidth="320" IsVisible="{Binding NeedsAddress}">
            <TextBox x:Name="AssistantAddress" Text="{Binding Address}" PlaceholderText="http://10.0.0.5:11434" />
          </ui:FormField>
          <ui:FormField Label="API key" InputWidth="320" IsVisible="{Binding NeedsKey}">
            <ui:PasswordBox x:Name="AssistantApiKey" Text="{Binding ApiKey}" PlaceholderText="{Binding ApiKeyPlaceholder}" />
          </ui:FormField>
          <ui:FormField Label="" Hint="{x:Static a:AssistantTexts.PicturesHint}">
            <CheckBox x:Name="AssistantPictures" Content="Send pictures to the model" IsChecked="{Binding SendPictures}" />
          </ui:FormField>
          <ui:FormField Label="Daily limit" InputWidth="320">
            <TextBox x:Name="AssistantDailyLimit" Text="{Binding DailyLimit}" Width="160" HorizontalAlignment="Left" />
          </ui:FormField>
          <ui:FormField Label="Per user" InputWidth="320" Hint="Optional">
            <TextBox x:Name="AssistantUserLimit" Text="{Binding UserDailyLimit}" Width="160" HorizontalAlignment="Left" />
          </ui:FormField>
        </StackPanel>
        <StackPanel Classes="form" IsVisible="{Binding !IsAdmin}">
          <ui:FormField Label="Provider" Hint="{Binding PrivacyNote}">
            <TextBlock Text="{Binding ProviderText}" />
          </ui:FormField>
          <ui:FormField Label="Send pictures">
            <TextBlock Text="{Binding SendPicturesText}" />
          </ui:FormField>
          <ui:FormField Label="Daily limit">
            <TextBlock Text="{Binding DailyLimitText}" />
          </ui:FormField>
          <ui:FormField Label="Per user">
            <TextBlock Text="{Binding UserDailyLimitText}" />
          </ui:FormField>
        </StackPanel>
        <ui:FormField Label="Used today">
          <TextBlock x:Name="AssistantUsedToday" Text="{Binding UsedTodayText}" />
        </ui:FormField>
        <ui:ProgressRow Text="{x:Static a:AssistantTexts.Testing}" IsVisible="{Binding IsTesting}" />
        <TextBlock x:Name="AssistantTestResult" Text="{Binding TestResult}" Classes.error="{Binding !TestOk}" TextWrapping="Wrap" IsVisible="{Binding HasTestResult}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" x:Name="AssistantSave" Classes="secondary" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding IsAdmin}"
                  ToolTip.Tip="{Binding SaveTip}" ToolTip.ShowOnDisabled="True" Margin="8,0,0,0" />
          <Button DockPanel.Dock="Right" x:Name="AssistantTurnOn" Classes="secondary" Content="Turn on" Command="{Binding TurnOnCommand}" IsVisible="{Binding ShowTurnOn}"
                  ToolTip.Tip="{Binding TurnOnTip}" ToolTip.ShowOnDisabled="True" Margin="8,0,0,0" />
          <Button DockPanel.Dock="Right" x:Name="AssistantTurnOff" Classes="secondary" Content="Turn off" Command="{Binding TurnOffCommand}" IsVisible="{Binding ShowTurnOff}"
                  Margin="8,0,0,0" />
          <Button DockPanel.Dock="Right" x:Name="AssistantTest" Classes="secondary" Content="Test" Command="{Binding TestCommand}" IsVisible="{Binding IsAdmin}"
                  ToolTip.Tip="{Binding TestTip}" ToolTip.ShowOnDisabled="True" Margin="8,0,0,0" />
          <ui:StatusChip HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding StatusText}" IsOk="{Binding IsOn}" MaxLines="2" />
        </DockPanel>
        <TextBlock Classes="error" Text="{Binding Message}" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      </Border>
    </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
